local function findFishingRod()
    if character then
        for _, tool in pairs(character:GetChildren()) do
            if tool:IsA("Tool") then
                local name = tool.Name:lower()
                if name:find("rod") or name:find("fish") or tool:GetAttribute("EquippedFishingRod") then
                    return tool, true
                end
            end
        end
    end
    for _, tool in pairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            local name = tool.Name:lower()
            if name:find("rod") or name:find("fish") or tool:GetAttribute("EquippedFishingRod") then
                return tool, false
            end
        end
    end
    return nil, false
end

local function listAllTools()
    if character then
        for _, tool in pairs(character:GetChildren()) do
            if tool:IsA("Tool") then
                warn(tool.Name)
            end
        end
    end
    for _, tool in pairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            warn(tool.Name)
        end
    end
end

local Net, FishingCast, FishingMinigameClick, FishingCancel

local function initializeRemotes()
    for attempt = 1, 10 do
        local success, err = pcall(function()
            Net = require(ReplicatedStorage.Packages.Net)
            FishingCast = Net:RemoteEvent("FishingRod.Cast")
            FishingMinigameClick = Net:RemoteEvent("FishingRod.MinigameClick")
            FishingCancel = Net:RemoteEvent("FishingRod.Cancel")
        end)
        if success then
            return true
        else
            logError("initializeRemotes", err)
            if attempt < 10 then
                task.wait(2)
            end
        end
    end
    return false
end

if not initializeRemotes() then
    error("CRITICAL: Failed to initialize remotes")
end

local TARGET_LUCK = 1.5
local LUCK_CYCLE = 1.0
local FIRST_PEAK_TIME = 0.425
local TOTAL_START_COMP = 0.650
local PERFECT_HOLD_DURATION = 0.07500
local CLICK_INTERVAL = 0.0345
local CLICKS_PER_BURST = 2
local BURST_INTERVAL = 0.0172
local YIELD_EVERY_N_CLICKS = 12
local MAX_CLICKS_PER_MINIGAME = 6000
local REEQUIP_CHECK_INTERVAL = 2.0
local INSTANT_EQUIP_RETRY = 1.0
local MAX_EQUIP_ATTEMPTS = 30
local MINIGAME_BUFFER = 0.4
local CAST_COMPLETE_WAIT = 3.5
local COOLDOWN_CHECK_WAIT = 1.0
local BITE_WAIT = 0.8
local MIN_YIELD_TIME = 0.03
local MINIGAME_POLL_INTERVAL = 0.15
local MINIGAME_TIMEOUT = 30.0
local ACTION_VERIFY_ATTEMPTS = 4
local ACTION_VERIFY_DELAY = 0.2

local lastCastTime = 0
local STUCK_TIMEOUT = 30

local function checkIfStuck()
    local timeSinceLastCast = tick() - lastCastTime
    if timeSinceLastCast > STUCK_TIMEOUT and isFishing then
        isMinigame = false
        isFishing = false
        task.spawn(function()
            task.wait(1)
            local rod = findFishingRod()
            if rod then
                pcall(function()
                    rod:Deactivate()
                end)
                task.wait(0.5)
                for i = 1, 10 do
                    if equipRod() then
                        isFishing = true
                        lastCastTime = tick()
                        break
                    end
                    task.wait(0.5)
                end
            end
        end)
    end
end

task.spawn(function()
    while true do
        task.wait(10)
        checkIfStuck()
    end
end)

local isFishing = false
local isMinigame = false
local lastClickTime = 0
local clickCount = 0
local yieldCounter = 0
local rodMonitored = nil
local lastRodCheck = 0
local equipAttempts = 0

local totalCasts = 0
local successfulCasts = 0
local totalFishCaught = 0
local missedFish = 0
local minigameCount = 0
local avgClicksPerMinigame = 0
local timingErrors = {}
local avgTimingError = 0
local sessionStartTime = tick()
local minigameStartTime = 0
local lastCastLuck = 0
local lastMinigameCheck = 0

local function verifyAttributeChange(rod, attributeName, expectedValue, maxAttempts)
    maxAttempts = maxAttempts or ACTION_VERIFY_ATTEMPTS
    for attempt = 1, maxAttempts do
        local success, value = pcall(function()
            return rod:GetAttribute(attributeName)
        end)
        if success then
            if expectedValue == nil or value == expectedValue then
                return true
            end
        end
        if attempt < maxAttempts then
            task.wait(ACTION_VERIFY_DELAY)
        end
    end
    return false
end

function equipRod()
    local rod, equipped = findFishingRod()
    if not rod then
        if equipAttempts % 10 == 0 then
            if equipAttempts == 10 then
                listAllTools()
            end
        end
        equipAttempts = equipAttempts + 1
        return false
    end
    if equipped then
        equipAttempts = 0
        return true
    end
    equipAttempts = equipAttempts + 1
    if equipAttempts > MAX_EQUIP_ATTEMPTS then
        equipAttempts = 0
        return false
    end
    if character and character:FindFirstChild("Humanoid") then
        local success, err = pcall(function()
            character.Humanoid:EquipTool(rod)
        end)
        if success then
            task.wait(0.5)
            local _, nowEquipped = findFishingRod()
            if nowEquipped then
                equipAttempts = 0
                return true
            end
        else
            logError("equipRod", err)
        end
    end
    return false
end

task.spawn(function()
    while true do
        pcall(function()
            if isFishing then
                local rod, equipped = findFishingRod()
                if rod and not equipped then
                    equipRod()
                end
            end
        end)
        task.wait(INSTANT_EQUIP_RETRY)
    end
end)

local function monitorRod(rod)
    if not rod or rodMonitored == rod then return end
    rodMonitored = rod
    local success, err = pcall(function()
        rod:GetAttributeChangedSignal("minigame"):Connect(function()
            task.wait(MINIGAME_BUFFER)
            local success, isActive = pcall(function()
                return rod:GetAttribute("minigame")
            end)
            if not success then return end
            isMinigame = isActive
            if isMinigame then
                lastClickTime = 0
                clickCount = 0
                yieldCounter = 0
                minigameStartTime = tick()
            else
                local hits = rod:GetAttribute("minigameHits") or 0
                local total = rod:GetAttribute("minigameTotalHits") or 0
                local minigameDuration = tick() - minigameStartTime
                local clicksPerSec = minigameDuration > 0 and (clickCount / minigameDuration) or 0
                minigameCount = minigameCount + 1
                avgClicksPerMinigame = ((avgClicksPerMinigame * (minigameCount - 1)) + clickCount) / minigameCount
                local caught = hits >= total
                if caught then
                    totalFishCaught = totalFishCaught + 1
                else
                    missedFish = missedFish + 1
                end
                logFishingAttempt(
                    lastCastLuck > 0 and lastCastLuck or 1.0,
                    minigameDuration,
                    clickCount,
                    clicksPerSec,
                    hits,
                    total,
                    caught
                )
                clickCount = 0
            end
        end)
    end)
    if not success then
        logError("monitorRod_minigame", err)
    end
    pcall(function()
        rod:GetAttributeChangedSignal("casted"):Connect(function()
            task.wait(MINIGAME_BUFFER)
            if rod:GetAttribute("casted") then
                successfulCasts = successfulCasts + 1
            end
        end)
    end)
    pcall(function()
        rod.Unequipped:Connect(function()
            rodMonitored = nil
            task.spawn(function()
                task.wait(0.5)
                for i = 1, 30 do
                    if equipRod() then break end
                    task.wait(INSTANT_EQUIP_RETRY)
                end
            end)
        end)
    end)
end

