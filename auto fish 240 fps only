local errorLog = {}
local maxLogEntries = 50
local errorCount = 0

local function logError(location, errorMsg)
    errorCount = errorCount + 1
    local entry = {
        time = os.date("%H:%M:%S"),
        location = location,
        error = tostring(errorMsg),
        count = errorCount
    }
    table.insert(errorLog, 1, entry)
    if #errorLog > maxLogEntries then
        table.remove(errorLog)
    end
    warn(string.format("[ERROR #%d] %s in %s: %s", errorCount, entry.time, location, errorMsg))
end

local function getErrorLog()
    if #errorLog == 0 then
        return
    end
    for i, entry in ipairs(errorLog) do
        warn(string.format("#%d [%s] %s: %s", entry.count, entry.time, entry.location, entry.error))
    end
end

local fishingLog = {}
local maxFishingLogEntries = 100

local function logFishingAttempt(luckMultiplier, minigameDuration, clicks, cps, hits, total, caught)
    local entry = {
        time = os.date("%H:%M:%S"),
        luck = luckMultiplier,
        duration = minigameDuration,
        clicks = clicks,
        cps = cps,
        hits = hits,
        total = total,
        caught = caught,
        efficiency = (hits / math.max(clicks, 1)) * 100
    }
    table.insert(fishingLog, 1, entry)
    if #fishingLog > maxFishingLogEntries then
        table.remove(fishingLog)
    end
end

local function getFishingLog()
    if #fishingLog == 0 then
        return
    end
    for i, entry in ipairs(fishingLog) do
        local result = entry.caught and "CAUGHT" or "MISSED"
        warn(string.format("%s | %s | %.2fx | %.2fs | %.1f | %d/%d | %.1f%%",
            entry.time, result, entry.luck, entry.duration, entry.cps,
            entry.hits, entry.total, entry.efficiency))
    end
end

local function getFishingStats()
    if #fishingLog == 0 then
        return
    end
    local totalAttempts = #fishingLog
    local caught = 0
    local totalLuck = 0
    local totalCPS = 0
    local totalEfficiency = 0
    local totalTime = 0
    for _, entry in ipairs(fishingLog) do
        if entry.caught then caught = caught + 1 end
        totalLuck = totalLuck + entry.luck
        totalCPS = totalCPS + entry.cps
        totalEfficiency = totalEfficiency + entry.efficiency
        totalTime = totalTime + entry.duration
    end
    local catchRate = (caught / totalAttempts) * 100
    local avgLuck = totalLuck / totalAttempts
    local avgCPS = totalCPS / totalAttempts
    local avgEfficiency = totalEfficiency / totalAttempts
    local avgTime = totalTime / totalAttempts
    local sessionTime = (tick() - sessionStartTime) / 3600
    local fishPerHour = sessionTime > 0 and (caught / sessionTime) or 0
    warn(string.format("Session Time: %.1f minutes", (tick() - sessionStartTime) / 60))
    warn(string.format("Total Attempts: %d", totalAttempts))
    warn(string.format("Caught: %d (%.1f%%)", caught, catchRate))
    warn(string.format("Missed: %d (%.1f%%)", totalAttempts - caught, 100 - catchRate))
    warn(string.format("Fish/Hour: %.1f", fishPerHour))
    warn(string.format("Average Luck: %.2fx", avgLuck))
    warn(string.format("Average CPS: %.1f", avgCPS))
    warn(string.format("Average Time: %.1fs", avgTime))
    warn(string.format("Average Efficiency: %.1f%%", avgEfficiency))
end

