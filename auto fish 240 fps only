local function clickMinigame()
    pcall(function()
        local rod = findFishingRod()
        if not rod or not rod:GetAttribute("minigame") then
            isMinigame = false
            return
        end
        local currentTime = tick()
        if currentTime - lastClickTime >= CLICK_INTERVAL then
            lastClickTime = currentTime
            if clickCount >= MAX_CLICKS_PER_MINIGAME then
                isMinigame = false
                return
            end
            for i = 1, CLICKS_PER_BURST do
                clickCount = clickCount + 1
                yieldCounter = yieldCounter + 1
                FishingMinigameClick:FireServer()
                if i < CLICKS_PER_BURST then
                    task.wait(BURST_INTERVAL)
                end
            end
            if yieldCounter >= YIELD_EVERY_N_CLICKS then
                yieldCounter = 0
                task.wait(0.035)
            end
        end
    end)
end

local function preciseWait(duration)
    if not duration or duration < 0 then return end
    pcall(function()
        task.wait(duration)
    end)
end

local function calculatePerfectCastStartTime()
    local currentTime = tick()
    local cyclePosition = currentTime % LUCK_CYCLE
    local targetActivationTime = FIRST_PEAK_TIME - TOTAL_START_COMP
    while targetActivationTime < 0 do
        targetActivationTime = targetActivationTime + LUCK_CYCLE
    end
    local waitTime
    if cyclePosition <= targetActivationTime then
        waitTime = targetActivationTime - cyclePosition
    else
        waitTime = (LUCK_CYCLE - cyclePosition) + targetActivationTime
    end
    return waitTime, targetActivationTime, cyclePosition
end

local function castRod()
    local rod, equipped = findFishingRod()
    if not rod then return false end
    if not equipped then return equipRod() end
    local canCast = true
    pcall(function()
        if rod:GetAttribute("casted") then canCast = false end
        if rod:GetAttribute("minigame") then canCast = false end
        if rod:GetAttribute("castCooldown") then canCast = false end
    end)
    if not canCast then return false end
    totalCasts = totalCasts + 1
    lastCastTime = tick()
    task.spawn(function()
        local success, err = pcall(function()
            local waitTime = calculatePerfectCastStartTime()
            if not waitTime or waitTime < 0 or waitTime > 2 then
                pcall(function()
                    rod:Activate()
                end)
                task.wait(0.2)
                pcall(function()
                    rod:Deactivate()
                end)
                task.wait(0.3)
                pcall(function()
                    FishingCast:FireServer(1.0)
                end)
                lastCastLuck = 1.0
                return
            end
            if waitTime > 0 then
                preciseWait(waitTime)
            end
            local clientActivateTime = tick()
            local success = pcall(function()
                rod:Activate()
            end)
            if not success then
                return
            end
            task.wait(0.3)
            preciseWait(PERFECT_HOLD_DURATION)
            local clientDeactivateTime = tick()
            local clientHoldDuration = clientDeactivateTime - clientActivateTime
            local serverSeesValue = clientHoldDuration % LUCK_CYCLE
            local luckMultiplier
            if serverSeesValue < 0.5 then
                luckMultiplier = 1 + serverSeesValue
            else
                luckMultiplier = 2 - serverSeesValue
            end
            lastCastLuck = luckMultiplier
            pcall(function()
                rod:Deactivate()
            end)
            task.wait(0.3)
            local castSuccess = pcall(function()
                FishingCast:FireServer(1.0)
            end)
            if not castSuccess then
                return
            end
            task.wait(0.5)
            local castRegistered = verifyAttributeChange(rod, "casted", true, 5)
            local timingError = math.abs(clientHoldDuration - FIRST_PEAK_TIME)
            table.insert(timingErrors, timingError)
            if #timingErrors > 50 then
                table.remove(timingErrors, 1)
            end
            local sum = 0
            for _, err in ipairs(timingErrors) do
                sum = sum + err
            end
            avgTimingError = sum / #timingErrors
        end)
        if not success then
            logError("castRod", err)
            pcall(function()
                rod:Deactivate()
            end)
            task.wait(1)
        end
    end)
    return true
end

local function ensureRodEquipped()
    if tick() - lastRodCheck < REEQUIP_CHECK_INTERVAL then
        return true
    end
    lastRodCheck = tick()
    local rod, equipped = findFishingRod()
    if not rod then return false end
    if not equipped then
        return equipRod()
    end
    if rodMonitored ~= rod then
        monitorRod(rod)
    end
    return true
end

local function fishingLoop()
    isFishing = true
    local loopCount = 0
    while isFishing do
        loopCount = loopCount + 1
        local success, err = pcall(function()
            ensureRodEquipped()
            local rod, equipped = findFishingRod()
            if not rod or not equipped then
                task.wait(REEQUIP_CHECK_INTERVAL)
                return
            end
            local inMinigame = rod:GetAttribute("minigame")
            local isCasted = rod:GetAttribute("casted")
            local onCooldown = rod:GetAttribute("castCooldown")
            if inMinigame or isMinigame then
                isMinigame = true
                clickMinigame()
                return
            end
            if not isCasted and not inMinigame and not onCooldown then
                if castRod() then
                    task.wait(CAST_COMPLETE_WAIT)
                else
                    task.wait(0.5)
                end
                return
            end
            if onCooldown then
                task.wait(COOLDOWN_CHECK_WAIT)
            elseif isCasted then
                task.wait(BITE_WAIT)
            else
                task.wait(0.5)
            end
        end)
        if not success then
            logError("fishingLoop", err)
            task.wait(1)
        end
    end
end

local function startFishing()
    if isFishing then
        return
    end
    sessionStartTime = tick()
    local rod, equipped = findFishingRod()
    if not rod then
        return
    end
    if not equipped then
        for i = 1, 20 do
            if equipRod() then
                break
            end
            task.wait(0.5)
        end
    end
    fishingLoop()
end

