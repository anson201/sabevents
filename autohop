local function checkBase(base, results, checked)
    local id = base.Name
    if checked[id] or not base:GetAttribute("Loaded") then return end
    checked[id] = true
    
    local ok, ch = pcall(sync.Wait, sync, id)
    if not ok or not ch then
        checked[id] = nil
        return
    end
    
    local owner = ch:Get("Owner")
    if not owner or owner == me then return end
    
    local pets = ch:Get("AnimalList")
    if not pets then return end
    
    for _, pet in pairs(pets) do
        if type(pet) == "table" and pet ~= "Empty" then
            local info = animalData[pet.Index]
            local rarity = info and info.Rarity
            if (rarity == "Secret" or rarity == "OG") and not pet.Steal and not pet.Machine then
                local gen = animalModule:GetGeneration(pet.Index, pet.Mutation, pet.Traits, owner)
                if gen >= 1000000 then
                    results[#results + 1] = {
                        owner = owner.Name,
                        name = pet.Index,
                        rarity = rarity,
                        gen = gen,
                        mut = pet.Mutation,
                        traits = pet.Traits
                    }
                end
            end
        end
    end
end

local function scan()
    if scanning then return nil end
    scanning = true
    local results = {}
    local checked = {}
    local bases = collection:GetTagged("Plot")
    local count = #bases
    local playerCnt = #plrs:GetPlayers()
    local batch = playerCnt <= 3 and 5 or playerCnt <= 5 and 8 or 10
    
    for i = 1, count, batch do
        for j = i, math.min(i + batch - 1, count) do
            checkBase(bases[j], results, checked)
        end
    end
    
    stats.scanned = stats.scanned + 1
    saveStats()
    
    if stats.scanned % 10 == 0 then
        task.spawn(sendStats)
    end
    
    if #results == 0 then return nil end
    
    table.sort(results, function(a, b)
        if a.rarity == "OG" and b.rarity ~= "OG" then return true
        elseif a.rarity ~= "OG" and b.rarity == "OG" then return false end
        return a.gen > b.gen
    end)
    
    local top = results[1]
    local matches = {top}
    if not stats.brainrots then stats.brainrots = {} end
    stats.brainrots[#stats.brainrots + 1] = top.rarity .. " - " .. top.name .. " - $" .. fmt(top.gen) .. "/s (Owner: " .. top.owner .. ")"
    
    local minRange, maxRange
    if top.gen >= 500000000 then
        minRange, maxRange = 500000000, math.huge
    elseif top.gen >= 100000000 then
        minRange, maxRange = 100000000, 500000000
    elseif top.gen >= 10000000 then
        minRange, maxRange = 10000000, 100000000
    else
        minRange, maxRange = 1000000, 10000000
    end
    
    for i = 2, #results do
        if results[i].gen >= minRange and results[i].gen < maxRange then
            matches[#matches + 1] = results[i]
        end
    end
    
    stats.found = stats.found + 1
    saveStats()
    
    local data = {owner = top.owner, best = top.gen, og = top.rarity == "OG", pets = matches}
    scanning = false
    return data
end

function hop()
    if hopping then 
        return 
    end
    
    local currentTime = tick()
    local timeSinceLastHop = currentTime - lastHopTime
    if timeSinceLastHop < MIN_HOP_DELAY then
        local waitTime = MIN_HOP_DELAY - timeSinceLastHop
        task.wait(waitTime)
    end
    
    hopping = true
    lastHopTime = tick()
    
    local placeId = game.PlaceId
    local currentServerId = game.JobId
    local maxAttempts = 5
    
    if not cfg.GetServerAPI or cfg.GetServerAPI == "" then
        task.wait(0.5)
        hopping = false
        pcall(tp.Teleport, tp, placeId, me)
        return
    end
    
    local teleportConnection
    local teleportFailed = false
    local targetServerId = nil
    
    teleportConnection = tp.TeleportInitFailed:Connect(function(player, teleportResult, errorMessage)
        if player == me then
            teleportFailed = true
        end
    end)
    
    local function cleanup()
        if teleportConnection then 
            pcall(function() teleportConnection:Disconnect() end)
            teleportConnection = nil
        end
        hopping = false
    end
    
    local baseDelay = 0.2 + math.random() * 0.3
    task.wait(baseDelay)
    
    for attempt = 1, maxAttempts do
        teleportFailed = false
        targetServerId = nil
        
        local getPayload = http:JSONEncode({
            action = "get",
            botId = tostring(me.UserId),
            currentServerId = currentServerId
        })
        
        local getSuccess, getResponse = pcall(request, {
            Url = cfg.GetServerAPI,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = getPayload
        })
        
        if getSuccess and getResponse and getResponse.StatusCode == 200 then
            local parseSuccess, serverData = pcall(http.JSONDecode, http, getResponse.Body)
            
            if parseSuccess and serverData and serverData.serverId then
                targetServerId = serverData.serverId
                print(serverData.serverId)
                task.wait(0.3)
                
                local tpSuccess = pcall(tp.TeleportToPlaceInstance, tp, placeId, serverData.serverId, me)
                
                if tpSuccess then
                    task.wait(1)
                    
                    if teleportFailed then
                        pcall(request, {
                            Url = cfg.GetServerAPI,
                            Method = "POST",
                            Headers = {["Content-Type"] = "application/json"},
                            Body = http:JSONEncode({
                                action = "failed", 
                                serverId = targetServerId, 
                                botId = tostring(me.UserId)
                            })
                        })
                        task.wait(0.5)
                        continue
                    end

                    pcall(request, {
                        Url = cfg.GetServerAPI,
                        Method = "POST",
                        Headers = {["Content-Type"] = "application/json"},
                        Body = http:JSONEncode({
                            action = "confirm", 
                            serverId = targetServerId, 
                            botId = tostring(me.UserId)
                        })
                    })
                    
                    cleanup()
                    return
                else
                    pcall(request, {
                        Url = cfg.GetServerAPI,
                        Method = "POST",
                        Headers = {["Content-Type"] = "application/json"},
                        Body = http:JSONEncode({
                            action = "failed", 
                            serverId = targetServerId, 
                            botId = tostring(me.UserId)
                        })
                    })
                    task.wait(0.8)
                end
            end
        elseif getSuccess and getResponse and getResponse.StatusCode == 404 then
            task.wait(2 + math.random() * 2)
        elseif getSuccess and getResponse and getResponse.StatusCode == 503 then
            local backoff = math.min(1 * (2 ^ (attempt - 1)), 8) + math.random() * 0.5
            task.wait(backoff)
        else
            task.wait(1 + math.random())
        end
    end
    
    cleanup()
    task.wait(1)
    pcall(tp.Teleport, tp, placeId, me)
end

