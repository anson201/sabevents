local function getImageUrl(petName)
    if not cachedHtml then 
        return nil 
    end
    
    local patterns = {
        'title="' .. petName .. '">.-<img[^>]-src="([^"]+)"',
        'title="' .. petName .. '">.-<img[^>]-data%-src="([^"]+)"',
        
        'alt="' .. petName .. '"[^>]-src="([^"]+)"',
        'alt="' .. petName .. '"[^>]-data%-src="([^"]+)"',
        
        '<a[^>]-title="' .. petName .. '"[^>]->.-<img[^>]-src="([^"]+)"',
        '<a[^>]-title="' .. petName .. '"[^>]->.-<img[^>]-data%-src="([^"]+)"',
        
        'data%-image%-name="' .. petName .. '"[^>]-href="([^"]+)"',
        'data%-image%-key="' .. petName .. '"[^>]-href="([^"]+)"',
    }
    
    for _, pattern in ipairs(patterns) do
        local imageUrl = cachedHtml:match(pattern)
        if imageUrl and not imageUrl:match("^data:image") and imageUrl:match("^http") then
            return imageUrl
        end
    end

    local escapedName = petName:gsub("([%^%$%(%)%%%.%[%]%*%+%-%?])", "%%%1")
    if escapedName ~= petName then
        for _, pattern in ipairs(patterns) do
            local escapedPattern = pattern:gsub(petName, escapedName)
            local imageUrl = cachedHtml:match(escapedPattern)
            if imageUrl and not imageUrl:match("^data:image") and imageUrl:match("^http") then
                return imageUrl
            end
        end
    end

    return nil
end

